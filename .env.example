# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

# Connexion PostgreSQL (format SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://utilisateur:mot_de_passe@localhost:5432/veloville

# Base PostgreSQL dediee aux tests, distincte de la base applicative.
TEST_DATABASE_URL=postgresql+psycopg://utilisateur:mot_de_passe@localhost:5432/veloville_test

# Jeton JWT
# Générer une clé aléatoire avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Front Streamlit : adresse de l'API
API_URL=http://localhost:8000
API_TIMEOUT_SECONDES=5
